{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "AI.News.Agent.Services.ArticleBodyService": "Debug",
            "AI.News.Agent.Services.ArticleSummarizationService": "Debug",
            "AI.News.Agent.Services.NewsApiService": "Debug",
            "AI.News.Agent.Services.PlaywrightRenderService": "Debug"
        }
    },
    "ApiKeys": {
        "NewsApiKey": "<your_api_key>",
        "HuggingFaceApiKey": "<your_api_key>",
        "OpenRouterApiKey": "<your_api_key>"
    },
    "ApiSettings": {
        "NewsApiBaseUrl": "https://newsapi.org/v2/top-headlines",
        "NewsApiEverythingBaseUrl": "https://newsapi.org/v2/everything"
    },
    "AI": {
        "ArticleSummarization": {
            "Model": "https://router.huggingface.co/hf-inference/models/facebook/bart-large-cnn"
        },
        "QueryParser": {
            "Url": "https://router.huggingface.co/v1/chat/completions",
            "Model": "Qwen/Qwen3-32B"
        },
        "ArticleRelevance": {
            "Url": "https://openrouter.ai/api/alpha/decisions",
            "Model": "typesafe/jev-1.13"
        }
    }
}